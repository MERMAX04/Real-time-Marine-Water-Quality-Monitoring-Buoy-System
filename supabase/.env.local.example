# =========================================================================
# supabase/.env.local.example  —  secrets ของ Edge Functions สำหรับ "Local dev" เท่านั้น
#
# วิธีใช้:  คัดลอกเป็น supabase/.env.local  (ไฟล์จริงถูก .gitignore ไว้ ห้าม commit)
#           แล้วรัน  supabase functions serve --env-file supabase/.env.local
#
# ⚠️ ค่าด้านล่างเป็นค่า local ปลอดภัย — อย่าใส่ token/รหัสจริงของ production
#    (ของ production อยู่ใน Supabase secrets บน cloud ไม่เกี่ยวกับไฟล์นี้)
#
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY ไม่ต้องใส่ — CLI ใส่ให้อัตโนมัติ
#   (ชื่อที่ขึ้นต้นด้วย SUPABASE_ ถ้าใส่ในไฟล์นี้ CLI จะข้ามให้)
# =========================================================================

# --- admin (ล็อกอินเว็บ /admin → เปลี่ยนโหมด) ---
ADMIN_USER=admin
ADMIN_PASS=localdev123

# --- telegram-alert (Database Webhook → เตือนเมื่อสถานะรวมแดง) ---
# ต้องตรงกับ header x-alert-secret ใน supabase/seed.sql (trigger local_dev_telegram_alert)
ALERT_WEBHOOK_SECRET=local-alert-secret

# --- telegram-bot + telegram-alert (ส่งข้อความเข้า Telegram) ---
# ค่าปลอมนี้ = เรียก api.telegram.org แล้วได้ 401 (ฟังก์ชันแค่ log "tgSend failed" ไม่พัง)
# ถ้าอยากทดสอบส่งจริง: สร้าง "บอททดสอบ" แยกจาก @BotFather แล้วใส่ token บอทนั้น (อย่าใช้บอท production)
TELEGRAM_BOT_TOKEN=000000000:LOCAL-DUMMY-TOKEN
# ค่าลับที่ Telegram แนบมาใน header x-telegram-bot-api-secret-token (ทดสอบด้วย curl ใส่ header นี้เอง)
TELEGRAM_WEBHOOK_SECRET=local-hook-secret
# chat_id ที่ใช้ /mode เปลี่ยนโหมดได้ (คั่นด้วย ,) — ค่าทดสอบ
TG_ADMINS=111111111
